<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_salesperson_list" model="ir.ui.view">
        <field name="name">sales.kpi.salesperson.list</field>
        <field name="model">sales.kpi.salesperson</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_salesperson_form" model="ir.ui.view">
        <field name="name">sales.kpi.salesperson.form</field>
        <field name="model">sales.kpi.salesperson</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>